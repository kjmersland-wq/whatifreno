# Copy to .env.local and fill in. Never commit real values.
# Paddle dashboard → Developer Tools → Authentication / Notifications.

# Client-side token (safe to expose). Sandbox tokens start with "test_", live with "live_".
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Server-side API key. SECRET. Used to verify transactions before export.
PADDLE_API_KEY=

# Secret of the notification destination pointing at /api/paddle/webhook. SECRET.
PADDLE_WEBHOOK_SECRET=

# Price (pri_...) of the one-off "tender pack" product.
NEXT_PUBLIC_PADDLE_PRICE_ID=

# "sandbox" or "production". Selects both Paddle.js and the server-side API host.
NEXT_PUBLIC_PADDLE_ENV=sandbox
